{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rambam-plugins": {
      "source": {
        "source": "github",
        "repo": "techRambam/rambam-plugins"
      }
    }
  },
  "enabledPlugins": {
    "core@rambam-plugins": true,
    "frontend@rambam-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
