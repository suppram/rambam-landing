#!/bin/sh
# Guardrail: block secrets/credentials from ever entering git history. Invoked by
# pre-commit and runs BEFORE the commit object is created, so a leaked key is
# stopped at the gate — not caught later in review, by which point it is already
# in history and must be rotated. Pure sh, no dependencies, so it ALWAYS runs
# (even via `git add -f`). Adapted from rambam-clinic's .githooks/secret-scan.
#
# Covers the credentials THIS repo handles (CLAUDE.md · Guardrails):
#   - the Vercel deploy-hook URL (lives ONLY in GitHub Actions secrets as
#     VERCEL_DEPLOY_HOOK_URL — pasting it into a file would let anyone deploy)
#   - generic shapes: Anthropic tokens, JWTs, PEM keys, Smoove/CRM API keys
#   - any staged real dotenv file — this static site needs no local secrets
#   - a conservative generic pass for hardcoded secret/token/key literals
#
# Emergency override (rare false positive): git commit --no-verify

red() { printf '\033[31m%s\033[0m\n' "$1" >&2; }
hit=''

# Diff base: HEAD normally; the empty-tree object on a repo's first commit.
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

# 1) No dotenv files in the tree — secrets load from the EXTERNAL .env only.
envfiles=$(git diff --cached --name-only --diff-filter=ACMR "$against" \
  | grep -E '(^|/)\.env([.-][^/]*)?$' | grep -v '\.env\.example$' || true)
if [ -n "$envfiles" ]; then
  red '✋ pre-commit blocked: a dotenv file is staged:'
  printf '%s\n' "$envfiles" | sed 's/^/     /' >&2
  red '   Secrets live in the external .env (see CLAUDE.md) and must never be committed.'
  red '   Unstage it:  git rm --cached <file>'
  exit 1
fi

# 2) Scan ADDED lines of the staged diff. Exclude ONLY this file (its own
# regexes would self-match); the rest of .githooks/ IS scanned.
added=$(git diff --cached --diff-filter=ACMR -U0 "$against" -- . ':(exclude).githooks/secret-scan' \
  | grep '^+' | grep -v '^+++' || true)

scan() { # $1 = ERE pattern, $2 = human label
  found=$(printf '%s\n' "$added" | grep -inE -- "$1" || true)
  if [ -n "$found" ]; then
    hit='1'
    red "✋ pre-commit blocked: possible $2 in staged changes:"
    printf '%s\n' "$found" | sed 's/^/     /' >&2
  fi
}

# High-confidence shapes (near-zero false positives).
scan 'sk-ant-[A-Za-z0-9_-]{18,}'                                     'Anthropic API / OAuth token'
scan '[0-9]{6,}:[A-Za-z0-9_-]{30,}'                                  'Telegram bot token'
scan 'eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}' 'JWT'
scan '-----BEGIN [A-Z ]*PRIVATE KEY-----'                            'PEM private key'
# Make webhook capability URLs. The token IS the credential: the endpoint is
# unauthenticated and the host (hook.<region>.make.com) is public and inferable, so
# anyone holding it can fire the scenario and write to whatever it drives. BOTH
# spellings are covered, because matching only the full URL is exactly how a bare
# token reached main in rambam-ops on 2026-08-26 (caught in review, not here).
scan 'https?://hook\.[a-z0-9-]+\.make\.com/[A-Za-z0-9]{10,}'         'Make webhook capability URL'
# The BARE udid: exactly 32 lowercase alphanumerics. Tested per TOKEN, not per line --
# a line-level test matches the ordinary prose around a hex digest and blocks every md5
# in the repo. Requiring one letter in [g-z] excludes md5/sha digests and hex GUIDs.
bare=$(printf '%s\n' "$added" | awk '
  {
    n = split($0, part, /[^a-z0-9]+/)
    for (i = 1; i <= n; i++)
      if (length(part[i]) == 32 && part[i] ~ /[g-z]/) { print NR ": " $0; break }
  }' || true)
if [ -n "$bare" ]; then
  hit='1'
  red '✋ pre-commit blocked: possible bare Make webhook token (32-char udid) in staged changes:'
  printf '%s\n' "$bare" | sed 's/^/     /' >&2
  red '   The udid alone lets anyone POST to the hook. Reference the numeric hook id instead.'
fi
scan 'api\.vercel\.com/v1/integrations/deploy/'                      'Vercel deploy-hook URL'

# Generic pass: a long QUOTED literal assigned to a secret-named identifier. The
# quoted-value-only match plus the placeholder/env-read filter keeps ordinary code
# (`token = os.environ[...]`, a bare "MAKE_API_KEY" dict lookup) from tripping it.
q='["'"'"']'
generic=$(printf '%s\n' "$added" \
  | grep -inE "(secret|token|passwd|password|client[_-]?secret|access[_-]?token|api[_-]?key|bot[_-]?token)$q?[[:space:]]*[:=][[:space:]]*$q[A-Za-z0-9_+/=.:-]{20,}$q" \
  | grep -ivE 'placeholder|example|your[_-]|xxxx|changeme|dummy|os\.environ|os\.getenv|getenv|environ\[|<[A-Za-z0-9_]+>' || true)
if [ -n "$generic" ]; then
  hit='1'
  red '✋ pre-commit blocked: possible hardcoded credential in staged changes:'
  printf '%s\n' "$generic" | sed 's/^/     /' >&2
fi

if [ -n "$hit" ]; then
  red '   Move it to the external .env and read it from there, or use a secret store.'
  red '   False positive? git commit --no-verify'
  exit 1
fi
exit 0
